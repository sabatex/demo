<UserControl x:Class="WpfLessons.StackPanelDemo"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfLessons"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Label>Orintation</Label>
            <ComboBox SelectedItem="{Binding ElementName=rainbowStackPanel, Path=Orientation, Mode=TwoWay}">
                <ComboBoxItem Content="{Binding Source={x:Static Orientation.Horizontal}}" ></ComboBoxItem>
                <ComboBoxItem Content="{Binding Source={x:Static Orientation.Vertical}}" ></ComboBoxItem>
            </ComboBox>
        </StackPanel>
    <StackPanel x:Name="rainbowStackPanel">
        <Label Width="200" Background="Red">Hello World</Label>
        <Label Width="200" Background="Orange">Hello World</Label>
        <Label Width="200" Background="Yellow">Hello World</Label>
        <Label Width="200" Background="Green">Hello World</Label>
        <Label Width="200" Background="Blue">Hello World</Label>
        <Label Width="200" Background="Indigo">Hello World</Label>
        <Label Width="200" Background="Violet">Hello World</Label>
    </StackPanel>
    </StackPanel>
</UserControl>
