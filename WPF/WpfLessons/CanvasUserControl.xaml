<UserControl x:Class="WpfLessons.CanvasUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfLessons"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Canvas>
        <Button Canvas.Left="100" Canvas.Bottom="100" >Button absolute</Button>
        <UniformGrid Columns="2" Rows="2">
            
            <Button Grid.RowSpan="1">Button1</Button>
            <Button Grid.Column="1">Button2</Button>
        </UniformGrid>   
    </Canvas>
</UserControl>
