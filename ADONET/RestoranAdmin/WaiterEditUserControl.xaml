<UserControl x:Class="RestoranAdmin.WaiterEditUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RestoranAdmin"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Name="window">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition />
        </Grid.RowDefinitions>
        <StackPanel>
            <Button Click="Save">Зберегти</Button>
        </StackPanel>
        <DataGrid Grid.Row="1" x:Name="dg" AutoGenerateColumns="False" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Пароль" Binding="{Binding Password}" Width="*"/>
               
                <DataGridTemplateColumn Header="Столики" Width="*" >
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DataGrid ItemsSource="{Binding ClientTableWaiters}" AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridComboBoxColumn x:Name="cb"  SelectedValueBinding="{Binding ClientTableId}" DisplayMemberPath="Name" SelectedValuePath="Id" ItemsSource="{Binding ElementName=window,Path=er }" />
                                </DataGrid.Columns>   
                            </DataGrid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
            
    </Grid>
</UserControl>
